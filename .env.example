# Local runtime environment variables
NATS_URL=nats://nats:4222
LANGGRAPH_URL=http://langgraph-orchestrator:5000
PORT=4000
LANGGRAPH_MODE=local
FRONTEND_PORT=3000

# Optional OpenTelemetry export (Arize Phoenix local)
OTEL_EXPORTER_OTLP_ENDPOINT=http://phoenix:6006/v1/traces
OTEL_EXPORTER_OTLP_HEADERS=

# Cosmos config (centralized switch)
# COSMOS_SOURCE=container -> use containerized cosmos-emulator in compose profile
# COSMOS_SOURCE=local -> use Cosmos Emulator installed on host machine
COSMOS_SOURCE=container
COSMOS_ENDPOINT_CONTAINER=https://cosmos-emulator:8081/
COSMOS_ENDPOINT_LOCAL=https://localhost:8081/
